[Unit]
Description=Kiosk (cage + Chrome on tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
ConditionPathExists=/dev/tty1
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=@KIOSK_USER@
PAMName=kiosk
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -s -- /usr/local/bin/kiosk-browser
Restart=always
# If memory runs short, have the kernel kill other processes before the
# browser. Chrome still raises its own tabs' scores, so a tab goes before
# the browser itself. (-1000 would exempt it entirely.)
OOMScoreAdjust=-500
RestartSec=5
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
