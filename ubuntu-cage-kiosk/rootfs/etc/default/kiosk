# Kiosk settings, read by /usr/local/bin/kiosk-* and by install-kiosk.sh.
#
# Each setting says when a change takes effect:
#   [restart]  sudo systemctl restart kiosk
#   [timer]    read each time its timer runs (brightness: every 5 minutes;
#              apply now with: sudo kiosk-brightness auto --force)
#   [install]  re-run install-kiosk.sh
#
# install-kiosk.sh rewrites this file from its template on every run, keeping the
# values set here (and filling in new settings with their defaults). Comments
# added here are not kept. To reuse settings on another install, copy this file
# and pass it with: sudo ./install-kiosk.sh --config <file>

# [restart] The page to show. Quote it: URLs with a query string contain '&'.
KIOSK_URL=''

# [restart] Server-down recovery (kiosk-watchdog): when the browser shows its own
# error page, or a 502/503/504 page, because the server was unreachable, reload
# KIOSK_URL as soon as the server responds again. This is the local DevTools port
# it uses (reachable only from this machine). Blank = no watchdog.
WATCHDOG_PORT='9222'

# [timer] Scheduled dimming: 'yes' = set the brightness on the schedule below;
# 'no' = never change it (e.g. a screen with no brightness control).
DIMMING='yes'

# [timer] Brightness schedule (24h HHMM) and levels (percent, 1-100).
DAY_START='0630'
NIGHT_START='2355'
DAY_BRIGHTNESS='100'
NIGHT_BRIGHTNESS='15'

# [timer] Laptop backlight device under /sys/class/backlight (blank = auto-detect).
# If there is no backlight device, ddcutil (DDC/CI) is used instead.
BACKLIGHT_DEVICE=''

# [install] Time of the scheduled restart check (24h HHMM). Blank = none: the
# browser then only restarts on reboot or if it exits.
RESTART_TIME='0430'

# [timer] At RESTART_TIME: 'yes' = restart the browser every day (clears slow
# memory growth); 'no' = restart only if Chrome was updated since it started.
RESTART_DAILY='yes'

# [install] 'yes' = let Ubuntu's automatic updates also update Google Chrome
# (by default they only update Ubuntu's own packages, so Chrome never updates).
# The new version runs after the next restart. 'no' = update Chrome yourself.
AUTO_UPDATE_CHROME='yes'

# [install] Sound card profile, e.g. 'output:hdmi-stereo' for sound out of an
# HDMI/DP monitor (README: "Sound out of a monitor's speakers" lists them).
# Blank = WirePlumber's automatic choice. A profile chosen by hand with pactl
# takes precedence until ~kiosk/.local/state/wireplumber is cleared.
AUDIO_PROFILE=''

# [install] 'yes' = ignore a touchscreen's extra "Mouse" interface, which many touch
# controllers have, so no mouse cursor is drawn on a touch-only kiosk. A separate
# mouse plugged in still works. 'no' = treat it as a mouse.
IGNORE_TOUCHSCREEN_MOUSE='yes'

# [restart] Extra Chrome flags, space separated (e.g. '--force-device-scale-factor=1.25').
EXTRA_CHROME_FLAGS=''

# [install] Laptop lid: 'suspend' (sleep when closed, wake when opened) or 'ignore'.
# Blank = auto: 'suspend' if the machine has a lid, else 'ignore'.
# Nothing else ever suspends the kiosk.
LID_SWITCH_ACTION=''
